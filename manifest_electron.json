{
	"manifest_version": 3,
	"name": "Claude Count Usage",
	"version": "1.0.0",
	"description": "Track your Claude.ai session and weekly usage. Shows usage bars in sidebar and token/cost/cache stats in the chat header. No telemetry. All data stays on your device.",
	"author": "Custom",
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": [
				"https://claude.ai/*"
			],
			"js": [
				"lib/browser-polyfill.min.js",
				"lib/o200k_base.js",
				"content-components/localization.js",
				"content-components/content_utils.js",
				"content-components/sse_bridge.js",
				"content-components/electron_reciever.js",
				"content-components/ui_dataclasses.js",
				"content-components/usage_ui.js",
				"content-components/length_ui.js"
			]
		},
		{
			"matches": [
				"https://claude.ai/*"
			],
			"js": [
				"injections/sse-watcher.js"
			],
			"world": "MAIN",
			"run_at": "document_start"
		}
	],
	"permissions": [
		"storage",
		"tabs",
		"scripting"
	],
	"host_permissions": [
		"*://claude.ai/*",
		"https://raw.githubusercontent.com/*",
		"https://github.com/*",
		"https://api.anthropic.com/*"
	],
	"web_accessible_resources": [
		{
			"resources": [
				"lib/browser-polyfill.min.js",
				"lib/o200k_base.js",
				"tracker-styles.css",
				"injections/webrequest-polyfill.js"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"icons": {
		"128": "icon128.png"
	},
	"incognito": "split"
}
