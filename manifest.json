{
	"manifest_version": 3,
	"name": "Claude Count Usage",
	"version": "1.5.3",
	"description": "See your Claude.ai session (5h) and weekly usage in the sidebar, plus token, cost and cache stats per chat. Runs locally.",
	"author": "Abdullah Alhar",
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": [
				"https://claude.ai/*"
			],
			"js": [
				"lib/browser-polyfill.min.js",
				"lib/o200k_base.js",
				"content-components/localization.js",
				"content-components/content_utils.js",
				"content-components/sse_bridge.js",
				"content-components/electron_reciever.js",
				"content-components/ui_dataclasses.js",
				"content-components/usage_ui.js",
				"content-components/settings_card.js",
				"content-components/length_ui.js"
			]
		},
		{
			"matches": [
				"https://claude.ai/*"
			],
			"js": [
				"injections/sse-watcher.js"
			],
			"world": "MAIN",
			"run_at": "document_start"
		}
	],
	"permissions": [
		"storage",
		"alarms",
		"notifications"
	],
	"host_permissions": [
		"https://claude.ai/*"
	],
	"web_accessible_resources": [
		{
			"resources": [
				"lib/browser-polyfill.min.js",
				"lib/o200k_base.js",
				"tracker-styles.css",
				"injections/webrequest-polyfill.js",
				"injections/sse-watcher.js"
			],
			"matches": [
				"https://claude.ai/*"
			]
		}
	],
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"incognito": "split",
	"action": {
		"default_title": "Claude Count Usage",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png"
		}
	},
	"homepage_url": "https://github.com/abdullah-alhar/claude-count-usage",
	"minimum_chrome_version": "111"
}
